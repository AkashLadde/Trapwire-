# TRAPWIRE environment configuration — copy to ".env" and adjust.

# ---- Admin Demo Login ----
TRAPWIRE_ADMIN_USER=admin
TRAPWIRE_ADMIN_PASS=Admin@2026!

# ---- Export Privacy & Hashing ----
# Dedicated salt used for one-way salted SHA-256 hashing on exported PII
TRAPWIRE_HASH_SALT=change-me-trapwire-export-salt

# ---- Database (MySQL) ----
# The app connects to MySQL first and auto-creates the database. If MySQL is
# unreachable OR pymysql isn't installed, it falls back to a local SQLite file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=trapwire
MYSQL_PASSWORD=strongpass
MYSQL_DATABASE=trapwire_db

# ---- Web session secret (change this for any non-local use) ----
TRAPWIRE_SECRET=change-me-to-a-long-random-string

# ---- Physical ESP32 alert node (red LED + buzzer + OLED) ----
# auto = use the board if one is plugged in; off = disable hardware entirely.
TRAPWIRE_HW=auto
# Force a serial port instead of auto-detect (optional):
# TRAPWIRE_HW_PORT=/dev/ttyUSB0        # Linux
# TRAPWIRE_HW_PORT=COM5                # Windows
# Or drive the node over Wi-Fi instead of USB (optional):
# TRAPWIRE_HW_URL=http://192.168.1.60
